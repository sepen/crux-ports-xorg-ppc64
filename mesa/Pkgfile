# Description: Mesa 3D Graphics Library
# URL: https://www.mesa3d.org/
# Maintainer: CRUX Xorg Team, xorg-ports at crux dot nu
# Arch Maiintainer: Jose Beneyto, sepen at crux-arm dot nu
# Depends on: elfutils libdrm libglvnd libva llvm python3-mako python3-pyyaml xorg-libxdamage xorg-libxrandr xorg-libxshmfence xorg-libxvmc xorg-libxxf86vm glslang
# Optional: libclc libdisplay-info libunwind lm_sensors vulkan-loader spirv-llvm-translator wayland-protocols

name=mesa
version=26.1.1
release=1
source=(https://archive.mesa3d.org/$name-$version.tar.xz)

build() {
    prt-get isinst libdisplay-info && PKGMK_MESA_OPTS+=' -D display-info=enabled'
    prt-get isinst libunwind && PKGMK_MESA_OPTS+=' -D libunwind=enabled'
    prt-get isinst lm_sensors && PKGMK_MESA_OPTS+=' -D lmsensors=enabled'

    PKGMK_MESA_GALLIUM='nouveau,r300,r600,radeonsi,svga,virgl,i915,llvmpipe'
    prt-get isinst directx-headers && PKGMK_MESA_GALLIUM+=',d3d12'
    prt-get isinst libclc && PKGMK_MESA_GALLIUM+=',crocus,iris'

    PKGMK_MESA_PLATFORMS='x11'
    prt-get isinst wayland-protocols && PKGMK_MESA_PLATFORMS+=',wayland'

    if prt-get isinst vulkan-loader; then
      PKGMK_MESA_GALLIUM+=',zink'
      PKGMK_VULKAN_DRIVERS+='amd,virtio' PKGMK_VULKAN_LAYERS+='overlay'
      prt-get isinst cbindgen rust-bindgen spirv-llvm-translator && PKGMK_MESA_VULKAN_DRIVERS+=',nouveau'
      prt-get isinst libclc python3-ply lua && PKGMK_MESA_VULKAN_DRIVERS+=',intel' PKGMK_MESA_VULKAN_LAYERS+=',intel-nullhw'
      prt-get isinst libclc && PKGMK_MESA_VULKAN_DRIVERS+=',intel_hasvk'
    fi

    printf '%s' "$version-$release" > $name-$version/VERSION

    meson setup build $name-$version $PKGMK_MESA_OPTS \
        --prefix=/usr \
        --sysconfdir=/etc \
        --buildtype=plain \
        -D b_lto=false \
        -D b_pie=true \
        -D egl=enabled \
        -D llvm=enabled \
        -D shared-llvm=enabled \
        -D gbm=enabled \
        -D gles1=disabled \
        -D gles2=enabled \
        -D glx=dri \
        -D gallium-drivers=${PKGMK_MESA_GALLIUM} \
        -D gallium-va=enabled \
        -D platforms=${PKGMK_MESA_PLATFORMS} \
        -D video-codecs=all \
        -D glvnd=enabled \
        -D vulkan-drivers=${PKGMK_VULKAN_DRIVERS} \
        -D vulkan-layers=${PKGMK_VULKAN_LAYERS}

    meson compile -C build -j ${JOBS:-1}
    DESTDIR=$PKG meson install -C build

    # indirect rendering symlink
    ln -s libGLX_mesa.so.0 $PKG/usr/lib/libGLX_indirect.so.0
}
